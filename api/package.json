{
  "name": "f1-results-api",
  "version": "1.0.0",
  "private": true,
  "description": "API local para cadastro e consulta de resultados de F1.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . ../frontend ../shared ../scripts",
    "duplicates": "jscpd --format javascript --min-lines 5 --min-tokens 50 --max-lines 2000 --threshold 0.1 --gitignore src tests ../frontend/server.js ../frontend/src ../shared ../scripts",
    "deps:check": "ncu --enginesNode --errorLevel 2 --reject jscpd",
    "deps:update": "ncu --enginesNode -u && npm install"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "jscpd": "^4.0.5",
    "npm-check-updates": "^23.1.1"
  }
}
