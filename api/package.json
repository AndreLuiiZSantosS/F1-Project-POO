{
  "name": "f1-results-api",
  "version": "1.0.0",
  "private": true,
  "description": "API local para cadastro e consulta de resultados de F1.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . ../frontend ../shared ../scripts",
    "deps:check": "ncu --enginesNode --errorLevel 2",
    "deps:update": "ncu --enginesNode -u && npm install"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.4.1",
    "npm-check-updates": "^22.2.9"
  }
}
